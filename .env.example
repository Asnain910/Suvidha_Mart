# ===================================================
# Suvidha Mart — Environment Configuration Template
# Copy this file to .env.local for local development
# or add these variables in your Vercel Project Settings
# ===================================================

# 1. MongoDB Atlas Connection URI
# Sign up free at: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true&serverSelectionTimeoutMS=2000&appName=mongosh+2.0.1
# 2. JWT Secret for authentication tokens
# You can generate any random string (e.g. openssl rand -base64 32)
JWT_SECRET=suvidha_mart_jwt_secret_key_production_2026

# 3. Base App URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
